// 3rd_party_lib_ohos:diffutils4cj/build/aarch64-linux-ohos/diffUtils4cj
// dependence: ../common_Values.cj
from std import unittest.*
from std import unittest.testmacro.*
from std import collection.*
from diffUtils4cj import diffUtils4cj.*

@Test
public class TestMyersDiffB001{
    /***
        public func buildPath(orig:  ArrayList<T>, rev:  ArrayList<T>): PathNode
        public init(equalizer: Equalizer<T>)
        public init()
        测试场景:rev，orig非空,且内容相同
    ***/
    public var orig=ArrayList<String>(["as","bg","rf","cd"])
    @TestCase
    func testMyersDiffBuildPath041(): Unit {
        var myersDiff01=MyersDiff<String>()
        var pathNode01=myersDiff01.buildPath(orig,orig)
        @Assert(pathNode01.toString(),"[(4,4)(0,0)]")
    }
    @TestCase
    func testMyersDiffBuildPath042(): Unit {
        var myersDiff02=MyersDiff<String>(SubEqualizer01<String>())
        var pathNode02=myersDiff02.buildPath(orig,orig)
        @Assert(pathNode02.toString(),"[(4,4)(0,0)]")
    }
}